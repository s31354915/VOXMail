# Generate with: openssl rand -base64 32
VOXMAIL_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

# Compose pulls this moving multi-arch tag by default. Set VOXMAIL_IMAGE to
# pin a release tag or digest instead.
# VOXMAIL_IMAGE=ghcr.io/s31354915/voxmail:latest

# The web console binds to the loopback interface by default. On a remote host,
# keep it here and reach it over an SSH tunnel, or change the bind address:
# VOXMAIL_HTTP_ADDR=127.0.0.1:8080
# VOXMAIL_HTTP_ADDR=0.0.0.0:8080

# SIP credentials are configured in the web console (SIP connection panel)
# and applied to the embedded call client. VOXMAIL_SIP_ACCOUNT exists only as a
# deployment override and follows baresip account-line syntax:
# VOXMAIL_SIP_ACCOUNT=<sip:number:password@provider.example>;regint=300
# VOXMAIL_PROVISION_MODELS=1
# VOXMAIL_GREETING_PATH=/data/prompts/welcome.wav
