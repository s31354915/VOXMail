# Generate with: openssl rand -base64 32
VOXMAIL_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

# Compose pulls this moving multi-arch tag by default. Set VOXMAIL_IMAGE to
# pin a release tag or digest instead.
# VOXMAIL_IMAGE=ghcr.io/s31354915/voxmail:latest

# Optional baresip account line. Example format varies by provider:
# VOXMAIL_SIP_ACCOUNT=<sip:number:password@provider.example>;regint=300
# VOXMAIL_PROVISION_MODELS=1
