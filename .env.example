# Generate with: openssl rand -base64 32
VOXMAIL_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

# Compose pulls this moving multi-arch tag by default. Set VOXMAIL_IMAGE to
# pin a release tag or digest instead.
# VOXMAIL_IMAGE=ghcr.io/s31354915/voxmail:latest

# The web console binds to the loopback interface by default. In Compose,
# VOXMAIL_HTTP_ADDR controls the container listener; the host port mapping in
# docker-compose.yml remains loopback unless that mapping is changed too. On a
# remote host, keep both settings private and use an SSH tunnel, or put a
# deliberately configured TLS reverse proxy in front:
# VOXMAIL_HTTP_ADDR=127.0.0.1:8080
# VOXMAIL_HTTP_ADDR=0.0.0.0:8080
# If a reverse proxy terminates TLS, list only its source CIDRs. Forwarded
# headers are ignored unless the immediate peer matches one of these networks.
# VOXMAIL_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# SIP credentials are configured in the web console (SIP connection panel)
# and applied to the embedded call client. VOXMAIL_SIP_ACCOUNT exists only as a
# deployment override and follows baresip account-line syntax:
# VOXMAIL_SIP_ACCOUNT=<sip:number:password@provider.example>;regint=300
# VOXMAIL_PROVISION_MODELS=1
# VOXMAIL_GREETING_PATH=/data/prompts/welcome.wav
# Durable terminal history is pruned at startup by age and per-table row cap.
# In-flight, queued, and uncertain reconciliation/submission rows are retained.
# VOXMAIL_HISTORY_RETENTION_DAYS=365
# VOXMAIL_HISTORY_MAX_ROWS=100000
